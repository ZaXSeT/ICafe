{
  "expo": {
    "name": "ICafe",
    "slug": "icafe-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icafe-icon.png",
    "scheme": "icafe",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icafe-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFAF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.icafe.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icafe-icon.png",
        "backgroundColor": "#FFFAF5"
      },
      "package": "com.icafe.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icafe-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icafe-icon.png",
          "backgroundColor": "#FFFAF5",
          "resizeMode": "contain"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
